#version 450

// Relights Gaussians (GaussianLighting): the captured SH degree-0 colour is
// the albedo; ambient light is weighted by the splat's average visibility,
// each point light by the visibility towards it (unless it is unshadowed), a
// Lambert term and a GGX microfacet term; splats near a glowing light emit. The lit colour replaces the captured one, blended by the
// relight value; at relight 0 the colour passes through unchanged.

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

layout(push_constant) uniform Counts {
    uvec4 counts; // x: number of Gaussians
} pc;

struct Material {
    vec4 normalRoughness;
    vec4 visibility0;
    vec4 visibility1;
    vec4 parameters; // x: visibility coefficient 8, y: metalness, z: specular scale
};

struct Light {
    vec4 positionRange;
    vec4 colourIntensity;
    vec4 shape; // x: reference distance, y: radius, z: 1 = unshadowed, w: glow radius
};

layout(scalar, set = 0, binding = 0) readonly buffer Positions { vec3 positions[]; };
layout(scalar, set = 0, binding = 1) readonly buffer Colours { vec4 colours[]; };
layout(scalar, set = 0, binding = 2) readonly buffer Materials { Material materials[]; };
layout(scalar, set = 0, binding = 3) readonly buffer Frame {
    vec4 camera;
    vec4 ambient;
    uvec4 counts;
    vec4 control;
    Light lights[8];
} frame;
layout(scalar, set = 0, binding = 4) writeonly buffer Lit { vec4 lit[]; };

const float kC0 = 0.282094792;
const float kPi = 3.14159265358979;

float visibility(Material m, vec3 d) {
    vec4 b0 = vec4(0.282094792, 0.488602512 * d.y, 0.488602512 * d.z, 0.488602512 * d.x);
    vec4 b1 = vec4(1.092548431 * d.x * d.y, 1.092548431 * d.y * d.z, 0.315391565 * (3.0 * d.z * d.z - 1.0),
                   1.092548431 * d.x * d.z);
    float b8 = 0.546274215 * (d.x * d.x - d.y * d.y);
    return clamp(dot(m.visibility0, b0) + dot(m.visibility1, b1) + m.parameters.x * b8, 0.0, 1.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.counts.x) {
        return;
    }
    vec4 c = colours[i];
    float relight = clamp(frame.control.x, 0.0, 1.0);
    if (relight <= 0.0) {
        lit[i] = c;
        return;
    }

    Material m = materials[i];
    vec3 albedo = max(c.rgb * kC0 + 0.5, vec3(0.0));
    vec3 p = positions[i];
    vec3 n = m.normalRoughness.xyz;
    vec3 toCamera = frame.camera.xyz - p;
    vec3 v = toCamera * inversesqrt(max(dot(toCamera, toCamera), 1e-12));
    // Thin translucent splats scatter light on either face.
    if (c.a < 0.8 && dot(n, v) < 0.0) {
        n = -n;
    }

    float ao = clamp(m.visibility0.x * kC0, 0.0, 1.0);
    vec3 result = albedo * frame.ambient.rgb * ao;

    float rough = max(m.normalRoughness.w, 0.05);
    float a2 = rough * rough * rough * rough;
    float metal = m.parameters.y;
    float specularScale = m.parameters.z;
    vec3 f0 = mix(vec3(0.04), albedo, metal);
    for (uint j = 0u; j < min(frame.counts.x, 8u); ++j) {
        Light light = frame.lights[j];
        vec3 delta = light.positionRange.xyz - p;
        float d2 = max(dot(delta, delta), 1e-12);
        float distance = sqrt(d2);
        float range = light.positionRange.w;
        if (range > 0.0 && distance >= range) {
            continue;
        }
        float glowRadius = light.shape.w;
        if (glowRadius > 0.0 && distance < glowRadius) {
            float fade = 1.0 - distance / glowRadius;
            result += light.colourIntensity.rgb * light.colourIntensity.w * fade * fade;
        }
        vec3 l = delta / distance;
        float nl = dot(n, l);
        if (nl <= 0.0) {
            continue;
        }
        float visible = light.shape.z > 0.5 ? 1.0 : visibility(m, l);
        if (visible <= 0.0) {
            continue;
        }
        float reference = light.shape.x;
        float attenuation = reference * reference / max(d2, light.shape.y * light.shape.y);
        if (range > 0.0) {
            attenuation *= pow(max(1.0 - pow(distance / range, 4.0), 0.0), 2.0);
        }
        vec3 diffuse = (1.0 - metal) * albedo / kPi;
        vec3 specular = vec3(0.0);
        if (specularScale > 0.0) {
            vec3 h = normalize(l + v);
            float nh = max(dot(n, h), 0.0);
            float nv = max(dot(n, v), 0.001);
            float vh = max(dot(v, h), 0.0);
            float denom = nh * nh * (a2 - 1.0) + 1.0;
            float distribution = a2 / (kPi * denom * denom);
            float k = (rough + 1.0) * (rough + 1.0) / 8.0;
            float geometry = (nv / (nv * (1.0 - k) + k)) * (nl / (nl * (1.0 - k) + k));
            vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
            specular = specularScale * distribution * geometry * fresnel / max(4.0 * nv * nl, 0.001);
        }
        result += (diffuse + specular) * light.colourIntensity.rgb * light.colourIntensity.w * attenuation * nl * visible;
    }

    vec3 shaded = (max(result, vec3(0.0)) - 0.5) / kC0;
    lit[i] = vec4(mix(c.rgb, shaded, relight), c.a);
}
