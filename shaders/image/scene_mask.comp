#version 450

// The scene mask: white where the depth buffer holds a surface, black where it holds +inf.

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D mask;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }
    bool surface = !isinf(depth[pixel.y * pc.width + pixel.x]);
    imageStore(mask, ivec2(pixel), surface ? vec4(1.0) : vec4(0.0, 0.0, 0.0, 1.0));
}
