#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PushConstants {
    uint elementCount;
    uint rank;
    uint inputDims[4];
    uint outputDims[4];
} pc;
layout(set = 0, binding = 0) restrict readonly buffer InputBuffer { int64_t inputData[]; };
layout(set = 0, binding = 1) restrict readonly buffer ShapeBuffer { int64_t shapeData[]; };
layout(set = 0, binding = 2) restrict writeonly buffer OutputBuffer { int64_t outputData[]; };
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.elementCount) return;
    uint remaining = index;
    uint inputIndex = 0;
    uint inputStride = 1;
    for (int axis = 3; axis >= 0; --axis) {
        uint coordinate = remaining % pc.outputDims[axis];
        remaining /= pc.outputDims[axis];
        inputIndex += (pc.inputDims[axis] == 1 ? 0 : coordinate) * inputStride;
        inputStride *= pc.inputDims[axis];
    }
    outputData[index] = inputData[inputIndex];
}
