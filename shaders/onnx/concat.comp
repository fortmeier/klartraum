#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PushConstants { uint outerCount; uint lhsAxisSize; uint rhsAxisSize; uint innerSize; uint elementCount; } pc;
layout(set = 0, binding = 0) restrict readonly buffer LhsBuffer { float lhs[]; };
layout(set = 0, binding = 1) restrict readonly buffer RhsBuffer { float rhs[]; };
layout(set = 0, binding = 2) restrict writeonly buffer OutputBuffer { float outputData[]; };
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.elementCount) return;
    uint outputBlock = (pc.lhsAxisSize + pc.rhsAxisSize) * pc.innerSize;
    uint outer = index / outputBlock;
    uint within = index % outputBlock;
    uint lhsBlock = pc.lhsAxisSize * pc.innerSize;
    outputData[index] = within < lhsBlock ? lhs[outer * lhsBlock + within]
                                         : rhs[outer * pc.rhsAxisSize * pc.innerSize + within - lhsBlock];
}
