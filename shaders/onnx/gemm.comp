#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(push_constant) uniform PushConstants { uint rows; uint columns; uint reduction; } pc;
layout(set = 0, binding = 0) restrict readonly buffer InputBuffer { float inputData[]; };
layout(set = 0, binding = 1) restrict readonly buffer WeightBuffer { float weights[]; };
layout(set = 0, binding = 2) restrict readonly buffer BiasBuffer { float bias[]; };
layout(set = 0, binding = 3) restrict writeonly buffer OutputBuffer { float outputData[]; };
void main() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || column >= pc.columns) return;
    float value = bias[column];
    for (uint k = 0; k < pc.reduction; ++k) value += inputData[row * pc.reduction + k] * weights[column * pc.reduction + k];
    outputData[row * pc.columns + column] = value;
}
