#version 450

// The close-up window around the character and its cameras
// (CloseUpWindow::update() and cropProjection() on the GPU). One invocation.
// The window is square in pixels; its size follows the body smoothly from
// frame to frame, kept in `state`, but never falls below 90 % of the body's.

layout(local_size_x = 1) in;

struct Camera {
    mat4 model;
    mat4 view;
    mat4 proj;
    vec4 cameraWorldPos;
};

layout(push_constant) uniform PushConstants {
    mat4 characterToScene;
    float aspect; // width / height of the full view
    uint jointCount;
} pc;

layout(set = 0, binding = 0) readonly buffer Joints { vec4 joints[]; };
layout(set = 0, binding = 1) uniform FullCamera { Camera full; };
// centre.xy, halfExtent.xy, halfY, initialized
layout(set = 0, binding = 2) buffer State { float state[]; };
// the scene's camera, then the skeleton's
layout(set = 0, binding = 3) writeonly buffer Cameras { Camera cameras[]; };

void main() {
    vec2 lower = vec2(1e9), upper = vec2(-1e9);
    mat4 toClip = full.proj * full.view * pc.characterToScene;
    for (uint i = 0; i < pc.jointCount; ++i) {
        vec4 clip = toClip * vec4(joints[i].xyz, 1.0);
        vec2 ndc = clip.xy / clip.w;
        lower = min(lower, ndc);
        upper = max(upper, ndc);
    }
    float target = max(0.08, 0.8 * max(upper.y - lower.y, (upper.x - lower.x) * pc.aspect));
    vec2 centre = 0.5 * (lower + upper);
    float halfY = state[5] != 0.0 ? state[4] + 0.35 * (target - state[4]) : target;
    halfY = max(halfY, 0.9 * target);
    vec2 halfExtent = vec2(halfY / pc.aspect, halfY);
    state[0] = centre.x;
    state[1] = centre.y;
    state[2] = halfExtent.x;
    state[3] = halfExtent.y;
    state[4] = halfY;
    state[5] = 1.0;

    mat4 crop = mat4(1.0);
    crop[0][0] = 1.0 / halfExtent.x;
    crop[1][1] = 1.0 / halfExtent.y;
    crop[3][0] = -centre.x / halfExtent.x;
    crop[3][1] = -centre.y / halfExtent.y;
    Camera scene = full;
    scene.proj = crop * full.proj;
    cameras[0] = scene;
    Camera skeleton = scene;
    skeleton.model = pc.characterToScene;
    cameras[1] = skeleton;
}
