#version 450

// The terrain's node selection (TreeTerrain, CDLOD): one workgroup walks the
// quadtree from the root, a level per step. The nodes of the current level
// are in one queue; each thread takes some of them and culls, draws or splits
// them (treeTerrainNodeAction()), putting the children of split nodes into
// the other queue for the next, finer level. The selected nodes and the
// indirect draw of all of them are the result; selectTerrainNodesReference()
// does the same on the CPU. It also writes the dispatch of the vertex pass.

#define TREE_CAMERA_SET 0
#define TREE_CAMERA_BINDING 5
#include "tree_render_common.glsl"

#define THREADS 256u

layout(local_size_x = 256) in;

// Per selected node: xy its lower corner (x, z), z its size, w its level.
layout(std430, binding = 0) writeonly buffer Nodes {
    vec4 nodes[];
};
layout(std430, binding = 1) writeonly buffer DrawArgs {
    uint drawArgs[4]; // vertexCount, instanceCount, firstVertex, firstInstance
};
// Two queues of node indices (ix, iz), queue q at [q * capacity, (q + 1) * capacity).
layout(std430, binding = 2) buffer Queues {
    uvec2 queues[];
};
layout(std430, binding = 3) readonly buffer Config {
    TreeTerrainConfig config;
};
layout(std430, binding = 4) readonly buffer Bounds {
    vec2 bounds[];
};
// The dispatch of tree_terrain_vertices.comp: a workgroup per selected node.
layout(std430, binding = 7) writeonly buffer DispatchArgs {
    uint dispatchArgs[3];
};
// TreeTerrainStat; zeroed before the pass.
layout(std430, binding = 6) buffer Stats {
    uint stats[];
};

shared uint queueCount[2];

void draw(uint ix, uint iz, uint level) {
    float size = treeTerrainNodeSize(config.lod, level);
    uint k = atomicAdd(stats[0], 1u);
    if (k < config.lod.levels.z) {
        nodes[k] = vec4(config.lod.root.x + float(ix) * size, config.lod.root.y + float(iz) * size, size, float(level));
    } else {
        atomicAdd(stats[3], 1u);
    }
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint capacity = config.lod.levels.w;
    mat4 viewProj = camera.proj * camera.view;
    vec3 eye = camera.cameraWorldPos.xyz;
    float zoom = treeTerrainZoom(camera.proj);
    if (t == 0u) {
        queues[0] = uvec2(0u, 0u);
        queueCount[0] = 1u;
        queueCount[1] = 0u;
    }
    memoryBarrierBuffer();
    memoryBarrierShared();
    barrier();

    uint current = 0u;
    for (int level = int(config.lod.levels.x) - 1; level >= 0; --level) {
        uint count = min(queueCount[current], capacity);
        uint next = 1u - current;
        for (uint i = t; i < count; i += THREADS) {
            uvec2 node = queues[current * capacity + i];
            vec2 heights = bounds[treeTerrainBoundsIndex(config.lod, node.x, node.y, uint(level))];
            uint action = treeTerrainNodeAction(config, viewProj, eye, zoom, node.x, node.y, uint(level), heights);
            if (action == TREE_TERRAIN_CULL) {
                atomicAdd(stats[1], 1u);
            } else if (action == TREE_TERRAIN_DRAW) {
                draw(node.x, node.y, uint(level));
            } else {
                uint q = atomicAdd(queueCount[next], 4u);
                if (q + 4u <= capacity) {
                    for (uint k = 0u; k < 4u; ++k) {
                        queues[next * capacity + q + k] = uvec2(2u * node.x + k % 2u, 2u * node.y + k / 2u);
                    }
                } else {
                    atomicAdd(stats[2], 1u);
                    draw(node.x, node.y, uint(level));
                }
            }
        }
        memoryBarrierBuffer();
        memoryBarrierShared();
        barrier();
        if (t == 0u) {
            queueCount[current] = 0u;
        }
        memoryBarrierShared();
        barrier();
        current = next;
    }

    if (t == 0u) {
        drawArgs[0] = 6u * uint(config.lod.ranges.z) * uint(config.lod.ranges.z);
        drawArgs[1] = min(stats[0], config.lod.levels.z);
        drawArgs[2] = 0u;
        drawArgs[3] = 0u;
        dispatchArgs[0] = min(stats[0], config.lod.levels.z);
        dispatchArgs[1] = 1u;
        dispatchArgs[2] = 1u;
    }
}
