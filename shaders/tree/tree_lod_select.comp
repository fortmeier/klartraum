#version 450

// Second pass of TreeMossLod: one thread per placed patch. Culls patches
// outside the view or smaller than 0.65 pixels, picks the level of detail from
// the patch's diameter in pixels (treeLodBlend()), and reserves its Gaussians
// in the pool: those of its level and, while crossfading, of the next coarser
// one. Patches that no longer fit are left out and counted.

#define TREE_CAMERA_SET 0
#define TREE_CAMERA_BINDING 4
#include "tree_render_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Instances {
    TreeLodInstance instances[];
};
layout(std430, binding = 1) readonly buffer Patches {
    TreeLodPatch patches[];
};
// Per instance: x first pool slot, y Gaussians, z level, w fade (float bits).
layout(std430, binding = 2) writeonly buffer Records {
    uvec4 records[];
};
// [0] Gaussians reserved, [1] patches left out for lack of room; zeroed before the pass.
layout(std430, binding = 3) buffer Counter {
    uint counter[];
};
layout(std430, binding = 5) readonly buffer Settings {
    TreeRenderSettings settings[];
};

layout(push_constant) uniform Push {
    uint instanceCount;
    uint capacity;
    uint pad0;
    uint pad1;
    vec4 boundaries; // xyz the pixel boundaries of levels 1 to 3, w the crossfade band
}
pc;

bool outsideFrustum(vec3 center, float radius) {
    mat4 m = camera.proj * camera.view;
    vec4 rows[4] = vec4[4](vec4(m[0][0], m[1][0], m[2][0], m[3][0]), vec4(m[0][1], m[1][1], m[2][1], m[3][1]),
                           vec4(m[0][2], m[1][2], m[2][2], m[3][2]), vec4(m[0][3], m[1][3], m[2][3], m[3][3]));
    vec4 planes[5] = vec4[5](rows[3] + rows[0], rows[3] - rows[0], rows[3] + rows[1], rows[3] - rows[1], rows[2]);
    for (int i = 0; i < 5; ++i) {
        vec4 p = planes[i] / length(planes[i].xyz);
        if (dot(p.xyz, center) + p.w < -radius) {
            return true;
        }
    }
    return false;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.instanceCount) {
        return;
    }
    TreeLodInstance inst = instances[i];
    TreeLodPatch source = patches[inst.ids.x];
    vec3 center = inst.posYaw.xyz;
    float radius = source.bounds.x * inst.plane.z;
    float pixels = treePixelDiameter(camera.cameraWorldPos.xyz, center, radius, treeFocalPixels(settings[0]));
    if (pixels < 0.65f || outsideFrustum(center, radius)) {
        records[i] = uvec4(0u);
        return;
    }
    vec2 lod = treeLodBlend(pixels, pc.boundaries.xyz, pc.boundaries.w);
    uint level = uint(lod.x);
    uint count = source.count[level];
    if (lod.y > 0.0f && level < 3u) {
        count += source.count[level + 1u];
    }
    uint base = atomicAdd(counter[0], count);
    if (base + count > pc.capacity) {
        atomicAdd(counter[1], 1u);
        records[i] = uvec4(0u);
        return;
    }
    records[i] = uvec4(base, count, level, floatBitsToUint(lod.y));
}
