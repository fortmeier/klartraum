#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// RMS normalization of `width`-wide rows: y = x / sqrt(mean(x^2) + eps) * scale.
// Each token holds `rowsPerToken` rows; only the params[0] active tokens are
// normalized. One 32-wide subgroup per row.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PushConstants {
    uint width;
    uint rowsPerToken;
    float epsilon;
} pc;
layout(set = 0, binding = 0) restrict readonly buffer InputBuffer { float X[]; };
layout(set = 0, binding = 1) restrict readonly buffer ScaleBuffer { float scale[]; };
layout(set = 0, binding = 2) restrict readonly buffer ParamsBuffer { uint params[]; };
layout(set = 0, binding = 3) restrict writeonly buffer OutputBuffer { float Y[]; };

void main() {
    const uint row = gl_WorkGroupID.x * (256u / 32u) + gl_SubgroupID;
    if (row >= params[0] * pc.rowsPerToken) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint offset = row * pc.width;
    float sum = 0.0;
    for (uint i = lane; i < pc.width; i += 32u) {
        const float value = X[offset + i];
        sum += value * value;
    }
    const float inverse = inversesqrt(subgroupAdd(sum) / float(pc.width) + pc.epsilon);
    for (uint i = lane; i < pc.width; i += 32u) Y[offset + i] = X[offset + i] * inverse * scale[i];
}
