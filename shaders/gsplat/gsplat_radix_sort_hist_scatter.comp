#version 450

#include "gsplat_radix_sort_include.glsl"

layout(local_size_x = 128) in;

shared uint sharedOffsets[16];
shared uint sharedBins[128];
shared uint localBinBase[16];
shared uint localRanks[128];   // precomputed stable ranks (avoids O(n²) scan)

void main() {
    /* This shader scatters elements into output based on histograms + prefix sums.
     *
     * Stability: elements with the same bin preserve their relative input order.
     * We compute stable local ranks in O(n) using a single-thread sequential pass
     * (thread 0 walks sharedBins[] and assigns ranks), replacing the previous
     * O(n²) approach where each thread scanned all earlier threads.
     */

    uint lid = gl_LocalInvocationID.x;

    if (lid < 16) {
        uint offsetIdx = gl_NumWorkGroups.x * lid + gl_WorkGroupID.x;
        sharedOffsets[lid] = inputBuffer3.histogram[offsetIdx];
    }
    barrier();

    uint itemsPerWorkGroup0 = pushConstants.numElements / gl_NumWorkGroups.x;
    uint iterationsPerWorkGroup = (itemsPerWorkGroup0 + gl_WorkGroupSize.x - 1) / gl_WorkGroupSize.x;
    uint itemsPerWorkGroup = iterationsPerWorkGroup * gl_WorkGroupSize.x;

    uint baseIdx = gl_WorkGroupID.x * itemsPerWorkGroup;
    uint endIdx  = baseIdx + itemsPerWorkGroup;

    for (uint groupStart = baseIdx; groupStart < endIdx; groupStart += gl_WorkGroupSize.x) {
        uint elemIdx  = groupStart + lid;
        bool isActive = (elemIdx < pushConstants.numElements);

        uint value = 0u, index = 0u, bin = 0u;
        if (isActive) {
            if (pushConstants.pass % 2 == 0) {
                value = radixValuesA[elemIdx];
                index = indexesA[elemIdx];
            } else {
                value = radixValuesB[elemIdx];
                index = indexesB[elemIdx];
            }
            bin = (value >> (pushConstants.pass * 4)) & 0xFu;
            sharedBins[lid] = bin;
        } else {
            sharedBins[lid] = 0xFFFFFFFFu;
        }
        barrier();

        // Thread 0 assigns stable local ranks in O(n) total work.
        // Walking sharedBins[] in thread-index order preserves input order within each bin.
        if (lid == 0u) {
            uint binCount[16];
            for (int b = 0; b < 16; b++) binCount[b] = 0u;
            for (uint j = 0u; j < gl_WorkGroupSize.x; j++) {
                uint b = sharedBins[j];
                if (b < 16u) {
                    localRanks[j] = binCount[b]++;
                }
            }
        }
        barrier();

        uint localRank = isActive ? localRanks[lid] : 0u;

        // First thread per bin atomically reserves its block of output slots.
        if (isActive && localRank == 0u) {
            uint count = 0u;
            for (uint j = 0u; j < gl_WorkGroupSize.x; j++) {
                if (sharedBins[j] == bin) count++;
            }
            localBinBase[bin] = atomicAdd(sharedOffsets[bin], count);
        }
        barrier();

        if (isActive) {
            uint pos = localBinBase[bin] + localRank;
            if (pushConstants.pass % 2 == 0) {
                radixValuesB[pos] = value;
                indexesB[pos]     = index;
            } else {
                radixValuesA[pos] = value;
                indexesA[pos]     = index;
            }
        }
        barrier();
    }
}
