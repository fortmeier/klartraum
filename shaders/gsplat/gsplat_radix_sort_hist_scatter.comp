#version 450

#include "gsplat_radix_sort_include.glsl"

layout(local_size_x = 128) in;

shared uint sharedOffsets[16];
shared uint sharedBins[128];
shared uint localBinBase[16];

void main() {
    /* This shader scatters the elements of the input buffer into the output buffer
     * based on the histograms and their prefix sum computed in the previous shader.
     *
     * Stability requirement: elements with the same bin must preserve their relative
     * input order across passes. We achieve this by processing one batch of
     * workGroupSize elements at a time and computing each thread's rank within its
     * bin using a sequential scan over shared memory (ordered by thread ID, which
     * corresponds to input order within the batch).
     */

    uint binIdx = gl_LocalInvocationIndex.x;

    if (binIdx < 16) {
        uint offsetIdx = gl_NumWorkGroups.x * binIdx + gl_WorkGroupID.x;
        sharedOffsets[binIdx] = inputBuffer3.histogram[offsetIdx];
    }
    barrier();

    uint itemsPerWorkGroup0 = pushConstants.numElements / gl_NumWorkGroups.x;
    uint iterationsPerWorkGroup = (itemsPerWorkGroup0 + gl_WorkGroupSize.x - 1) / gl_WorkGroupSize.x;
    uint itemsPerWorkGroup = iterationsPerWorkGroup * gl_WorkGroupSize.x;

    uint baseIdx = gl_WorkGroupID.x * itemsPerWorkGroup;
    uint endIdx  = baseIdx + itemsPerWorkGroup;

    // Process one batch of workGroupSize elements at a time
    for (uint groupStart = baseIdx; groupStart < endIdx; groupStart += gl_WorkGroupSize.x) {
        uint elemIdx = groupStart + gl_LocalInvocationID.x;
        bool isActive  = (elemIdx < pushConstants.numElements);

        uint value = 0, index = 0, bin = 0;
        if (isActive) {
            if (pushConstants.pass % 2 == 0) {
                value = radixValuesA[elemIdx];
                index = indexesA[elemIdx];
            } else {
                value = radixValuesB[elemIdx];
                index = indexesB[elemIdx];
            }
            bin = (value >> (pushConstants.pass * 4)) & 0xF;
            sharedBins[gl_LocalInvocationID.x] = bin;
        } else {
            sharedBins[gl_LocalInvocationID.x] = 0xFFFFFFFFu; // sentinel for inisActive
        }
        barrier();

        // Sequential scan: count how many earlier threads in this batch share the same bin.
        // This gives a stable, deterministic local rank (ordered by thread/input index).
        uint localRank = 0;
        if (isActive) {
            for (uint j = 0; j < gl_LocalInvocationID.x; j++) {
                if (sharedBins[j] == bin) localRank++;
            }
        }

        // The first thread (smallest ID) with each bin atomically reserves a block
        // of slots and records the base position for that bin in this batch.
        if (isActive && localRank == 0) {
            uint count = 0;
            for (uint j = 0; j < gl_WorkGroupSize.x; j++) {
                if (sharedBins[j] == bin) count++;
            }
            localBinBase[bin] = atomicAdd(sharedOffsets[bin], count);
        }
        barrier();

        // Write each element to its stable output position
        if (isActive) {
            uint pos = localBinBase[bin] + localRank;
            if (pushConstants.pass % 2 == 0) {
                radixValuesB[pos] = value;
                indexesB[pos] = index;
            } else {
                radixValuesA[pos] = value;
                indexesA[pos] = index;
            }
        }
        barrier();
    }
}
