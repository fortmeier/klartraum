#version 450
#extension GL_EXT_scalar_block_layout : enable

#include "gsplat_types.glsl"

layout(local_size_x = 128) in;

// SoA inputs from projection
layout(scalar, set = 0, binding = 0) readonly buffer Pos2DBuf  { vec2  pos2D[];  };
layout(scalar, set = 0, binding = 1) readonly buffer ZBuf      { float zBuf[];   };
layout(scalar, set = 0, binding = 2) readonly buffer CovInvBuf { vec4  covInv[]; }; // (m00,m10,m01,m11)

layout(scalar, set = 0, binding = 3) buffer HistogramBuf { uint histogram[]; };
layout(scalar, set = 0, binding = 4) buffer OffsetBuf    { uint offsets[];   };

layout(push_constant) uniform PC {
    uint  numElements;
    uint  gridSize;
    float screenWidth;
    float screenHeight;
} pc;

shared uint sharedHisto[16];

bool overlapsWithBin(vec2 position, mat2 covarianceInv, uint binIdx) {
    float cellW = pc.screenWidth  / float(pc.gridSize);
    float cellH = pc.screenHeight / float(pc.gridSize);
    uint gridX = binIdx % pc.gridSize;
    uint gridY = binIdx / pc.gridSize;
    vec2 binMin = vec2(gridX * cellW, gridY * cellH);
    vec2 binMax = vec2((gridX + 1) * cellW, (gridY + 1) * cellH);
    mat2 cov = inverse(covarianceInv);
    float spreadX = sqrt(cov[0][0]) * 2.5;
    float spreadY = sqrt(cov[1][1]) * 2.5;
    vec2 gMin = position - vec2(spreadX, spreadY);
    vec2 gMax = position + vec2(spreadX, spreadY);
    return !(gMax.x < binMin.x || gMin.x > binMax.x ||
             gMax.y < binMin.y || gMin.y > binMax.y);
}

void main() {
    uint lid  = gl_LocalInvocationIndex;
    uint idx  = gl_GlobalInvocationID.x;
    uint wgID = gl_WorkGroupID.x;
    uint numBins = pc.gridSize * pc.gridSize;

    if (lid < numBins) sharedHisto[lid] = 0u;
    barrier();

    if (idx < pc.numElements) {
        float z = zBuf[idx];
        if (z >= 0.0 && z <= 1.0) {
            vec2 pos = pos2D[idx];
            vec4 ci  = covInv[idx];
            mat2 covInvMat = mat2(ci.x, ci.y, ci.z, ci.w);
            for (uint b = 0; b < numBins; b++) {
                if (overlapsWithBin(pos, covInvMat, b)) {
                    atomicAdd(sharedHisto[b], 1u);
                }
            }
        }
    }
    barrier();

    if (lid < numBins) {
        histogram[gl_NumWorkGroups.x * lid + wgID] = sharedHisto[lid];
    }

    if (lid == 0) {
        offsets[wgID] = (wgID == 0) ? 0u : 0xFFFFFFFFu;
    }
}
