#version 450
#extension GL_EXT_scalar_block_layout : enable

#include "gsplat_types.glsl"

layout(local_size_x = 128) in;

// SoA inputs from projection
layout(scalar, set = 0, binding = 0) readonly buffer Pos2DBuf  { vec2  pos2D[];  };
layout(scalar, set = 0, binding = 1) readonly buffer ZBuf      { float zBuf[];   };
layout(scalar, set = 0, binding = 2) readonly buffer CovInvBuf { vec4  covInv[]; }; // (m00,m10,m01,m11)

layout(scalar, set = 0, binding = 3) buffer HistogramBuf { uint histogram[]; };
layout(scalar, set = 0, binding = 4) buffer OffsetBuf    { uint offsets[];   };

layout(push_constant) uniform PC {
    uint  numElements;
    uint  gridSize;
    float screenWidth;
    float screenHeight;
    float spreadMultiplier;   // tunable: Gaussian footprint radius multiplier (default 2.5)
} pc;

shared uint sharedHisto[16];

// Compute 2D spread (stddev × multiplier) directly from the inverse covariance vec4,
// avoiding a full mat2 inverse() call.
// covInv is stored column-major as (m00, m10, m01, m11):
//   mat = [[m00, m01], [m10, m11]]  with symmetric m10==m01
// cov[0][0] = m11 / det,  cov[1][1] = m00 / det,  det = m00*m11 - m01*m10
vec2 computeSpread(vec4 ci) {
    float det = ci.x * ci.w - ci.y * ci.z;
    return sqrt(vec2(ci.w, ci.x) / det) * pc.spreadMultiplier;
}

bool overlapsWithBin(vec2 position, vec2 spread, uint binIdx) {
    float cellW = pc.screenWidth  / float(pc.gridSize);
    float cellH = pc.screenHeight / float(pc.gridSize);
    uint gridX = binIdx % pc.gridSize;
    uint gridY = binIdx / pc.gridSize;
    vec2 binMin = vec2(float(gridX) * cellW,        float(gridY) * cellH);
    vec2 binMax = vec2(float(gridX + 1u) * cellW,   float(gridY + 1u) * cellH);
    vec2 gMin = position - spread;
    vec2 gMax = position + spread;
    return !(gMax.x < binMin.x || gMin.x > binMax.x ||
             gMax.y < binMin.y || gMin.y > binMax.y);
}

void main() {
    uint lid  = gl_LocalInvocationIndex;
    uint idx  = gl_GlobalInvocationID.x;
    uint wgID = gl_WorkGroupID.x;
    uint numBins = pc.gridSize * pc.gridSize;

    if (lid < numBins) sharedHisto[lid] = 0u;
    barrier();

    if (idx < pc.numElements) {
        float z = zBuf[idx];
        if (z >= 0.0 && z <= 1.0) {
            vec2 pos    = pos2D[idx];
            vec4 ci     = covInv[idx];
            vec2 spread = computeSpread(ci);   // computed once, shared across all bin tests
            for (uint b = 0u; b < numBins; b++) {
                if (overlapsWithBin(pos, spread, b)) {
                    atomicAdd(sharedHisto[b], 1u);
                }
            }
        }
    }
    barrier();

    if (lid < numBins) {
        histogram[gl_NumWorkGroups.x * lid + wgID] = sharedHisto[lid];
    }

    if (lid == 0) {
        offsets[wgID] = (wgID == 0) ? 0u : 0xFFFFFFFFu;
    }
}
