#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 128) in;

// Binned SoA inputs — only binMask and z are needed for key extraction
layout(scalar, set = 0, binding = 0) readonly buffer BinMaskBuf { uint  binMask[]; };
layout(scalar, set = 0, binding = 1) readonly buffer ZBuf       { float zBuf[];    };
layout(scalar, set = 0, binding = 2) readonly buffer CountBuf   { uint  totalCount; };

layout(scalar, set = 0, binding = 3) buffer SortValues  { uint values[];  };
layout(scalar, set = 0, binding = 4) buffer SortIndexes { uint indexes[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= totalCount) return;

    // Sort key: (binIndex[3:0] << 28) | (floatBitsToUint(z) >> 4)
    uint binIdx = uint(findMSB(binMask[idx]));
    uint zBits  = floatBitsToUint(zBuf[idx]) >> 4;
    values[idx]  = (binIdx << 28u) | zBits;
    indexes[idx] = idx;
}
