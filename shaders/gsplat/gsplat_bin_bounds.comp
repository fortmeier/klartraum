#version 450
#extension GL_EXT_scalar_block_layout : enable

#include "gsplat_types.glsl"

layout(local_size_x = 256) in;

// Sorted SoA — only binMask is needed for bounds computation
layout(scalar, set = 0, binding = 0) readonly buffer BinMaskBuf { uint binMask[]; };
layout(scalar, set = 0, binding = 1) readonly buffer CountBuf   { uint totalCount; };
layout(scalar, set = 0, binding = 2) buffer BoundsBuf           { StartAndEnd startAndEnd[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= totalCount) return;

    if (idx == totalCount - 1) {
        uint bm  = binMask[idx];
        uint bin = uint(log2(bm));
        startAndEnd[bin].end = idx + 1;
        return;
    }

    uint bm0   = binMask[idx];
    uint bm1   = binMask[idx + 1];
    uint bin0  = uint(log2(bm0));
    uint bin1  = uint(log2(bm1));

    if (bm0 != bm1) {
        startAndEnd[bin0].end   = idx + 1;
        startAndEnd[bin1].start = idx + 1;
    }
}
