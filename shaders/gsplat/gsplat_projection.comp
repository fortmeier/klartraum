#version 450
#extension GL_EXT_scalar_block_layout : enable

#include "gsplat_types.glsl"

layout(local_size_x = 128) in;

// --- Gaussian3D SoA inputs (band-major SH: shR[band * numElements + idx]) ---
layout(scalar, set = 0, binding = 0) readonly buffer Positions   { vec3  positions[];  };
layout(scalar, set = 0, binding = 1) readonly buffer Rotations   { vec4  rotations[];  };
layout(scalar, set = 0, binding = 2) readonly buffer Scales      { vec3  scales[];     };
layout(scalar, set = 0, binding = 3) readonly buffer ColorsAlpha { vec4  colorsAlpha[]; }; // (r,g,b,alpha)
layout(scalar, set = 0, binding = 4) readonly buffer ShR         { float shR[];        };  // shR[band*N+idx]
layout(scalar, set = 0, binding = 5) readonly buffer ShG         { float shG[];        };
layout(scalar, set = 0, binding = 6) readonly buffer ShB         { float shB[];        };

layout(set = 0, binding = 7) uniform UBO {
    mat4 model;
    mat4 view;
    mat4 proj;
} ubo;

// --- Gaussian2D SoA outputs ---
layout(scalar, set = 0, binding = 8)  buffer Pos2D       { vec2  pos2D[];       };
layout(scalar, set = 0, binding = 9)  buffer ZBuf        { float zBuf[];        };
layout(scalar, set = 0, binding = 10) buffer BinMaskBuf  { uint  binMaskBuf[];  };
// covInv packed as vec4: (m[0][0], m[0][1], m[1][0], m[1][1]) — column-major
layout(scalar, set = 0, binding = 11) buffer CovInvBuf   { vec4  covInvBuf[];   };
layout(scalar, set = 0, binding = 12) buffer ColorAlpha2D{ vec4  colorAlpha2D[]; }; // (r,g,b,alpha)

layout(push_constant) uniform PC {
    uint  numElements;
    uint  gridSize;
    float screenWidth;
    float screenHeight;
} pc;

mat3 quatToMat3(vec4 q) {
    float x = q.x, y = q.y, z = q.z, w = q.w;
    float xx = x*x, yy = y*y, zz = z*z;
    float xy = x*y, xz = x*z, yz = y*z;
    float wx = w*x, wy = w*y, wz = w*z;
    return mat3(
        1.0 - 2.0*(yy+zz),  2.0*(xy-wz),        2.0*(xz+wy),
        2.0*(xy+wz),        1.0 - 2.0*(xx+zz),  2.0*(yz-wx),
        2.0*(xz-wy),        2.0*(yz+wx),        1.0 - 2.0*(xx+yy)
    );
}

// Projected 2D covariance of a 3D Gaussian, in NDC units (Kerbl et al. 2023, Sec. 4;
// Zwicker et al., EWA Splatting 2002). The caller scales the entries to pixels.
mat2 computeCovarianceMatrix2D(vec3 p, vec4 rotation, vec3 gscale) {
    // 3D covariance Sigma = R S S^T R^T (Kerbl Eq. 6). quatToMat3 fills the mat3
    // constructor column by column with the rows of the rotation matrix, so it
    // returns R^T; transposing it yields R.
    mat3 R = transpose(quatToMat3(rotation));
    mat3 RS = R * mat3(gscale.x, 0.0, 0.0,
                       0.0, gscale.y, 0.0,
                       0.0, 0.0, gscale.z);
    mat3 Sigma = RS * transpose(RS);

    // Viewing transformation W and the camera-space mean t.
    mat4 modelView = ubo.model * ubo.view;
    mat3 W = mat3(modelView);
    vec3 t = (modelView * vec4(p, 1.0)).xyz;

    // Signed focal terms; proj[1][1] is negative due to Vulkan's Y-flip, and the
    // sign carries through to the Jacobian's off-diagonal term.
    float fx = ubo.proj[0][0];
    float fy = ubo.proj[1][1];

    // The camera looks down -z (clip w = -t.z), so ndc = (-fx * t.x / t.z, -fy * t.y / t.z).
    // The affine approximation is evaluated at the mean, with the projected x/y
    // limited to a [-1.3, 1.3] NDC guard band (keeping the depth) so Gaussians far
    // outside the view do not get an exploding Jacobian.
    float limX = 1.3 / abs(fx);
    float limY = 1.3 / abs(fy);
    float tx = clamp(t.x / t.z, -limX, limX);
    float ty = clamp(t.y / t.z, -limY, limY);

    // Jacobian of the NDC x/y w.r.t. camera-space position (local affine
    // approximation of Zwicker et al.); the third row is zero, so only the upper-left
    // 2x2 block of the result is meaningful.
    mat3 J = mat3(
        -fx / t.z,      0.0,            0.0,
        0.0,            -fy / t.z,      0.0,
        fx * tx / t.z,  fy * ty / t.z,  0.0
    );

    // Sigma' = J W Sigma W^T J^T (Kerbl Eq. 5), keeping its 2x2 image-plane part.
    mat3 T = J * W;
    mat3 cov = T * Sigma * transpose(T);
    return mat2(cov);
}

float computeSH(float base, float coeffs[15], vec3 dir) {
    float x = dir.x, y = dir.y, z = dir.z;
    float x2 = x*x, y2 = y*y, z2 = z*z;
    float sh[16];
    sh[0]  = 0.282095;
    sh[1]  = -0.488603 * y;
    sh[2]  = -0.488603 * z;
    sh[3]  = -0.488603 * x;
    sh[4]  = 1.092548 * x * y;
    sh[5]  = -1.092548 * y * z;
    sh[6]  = 0.315392 * (2.0*z2 - x2 - y2);
    sh[7]  = -1.092548 * x * z;
    sh[8]  = 0.546274 * (x2 - y2);
    sh[9]  = -0.590044 * y * (3.0*x2 - y2);
    sh[10] = 2.890611 * x * y * z;
    sh[11] = -0.457046 * y * (4.0*z2 - x2 - y2);
    sh[12] = 0.373176 * z * (2.0*z2 - 3.0*x2 - 3.0*y2);
    sh[13] = -0.457046 * x * (4.0*z2 - x2 - y2);
    sh[14] = 1.445306 * z * (x2 - y2);
    sh[15] = -0.590044 * x * (x2 - 3.0*y2);
    float value = 0.5 + base * sh[0];
    for (int i = 0; i < 15; i++) value += coeffs[i] * sh[i + 1];
    return value;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.numElements) return;

    vec3 p  = positions[idx];
    vec4 r  = rotations[idx];
    vec3 s  = scales[idx];
    vec4 ca = colorsAlpha[idx];

    // Load SH coefficients: band-major layout shX[band * numElements + idx]
    float shRc[15], shGc[15], shBc[15];
    for (int i = 0; i < 15; i++) {
        shRc[i] = shR[i * pc.numElements + idx];
        shGc[i] = shG[i * pc.numElements + idx];
        shBc[i] = shB[i * pc.numElements + idx];
    }

    // Project position to clip space
    vec4 clipPos = ubo.proj * ubo.view * ubo.model * vec4(p, 1.0);
    vec2 normPos = clipPos.xy / clipPos.w;
    float depth  = (clipPos.xyz / clipPos.w).z;

    float swh = pc.screenWidth  * 0.5;
    float shh = pc.screenHeight * 0.5;

    pos2D[idx]      = vec2((normPos.x + 1.0) * swh, (normPos.y + 1.0) * shh);
    zBuf[idx]       = depth;
    binMaskBuf[idx] = uint(-1); // downstream binning pass fills real value

    // Compute projected covariance and its inverse.
    // The Jacobian maps NDC (which spans 2 units) to pixels anisotropically:
    // x by (screenWidth/2)² and y by (screenHeight/2)²
    mat2 cov = computeCovarianceMatrix2D(p, r, s);
    cov[0][0] *= swh * swh;
    cov[0][1] *= swh * shh;
    cov[1][0] *= swh * shh;
    cov[1][1] *= shh * shh;
    cov[0][0] += 0.3;
    cov[1][1] += 0.3;
    mat2 covI = inverse(cov);
    // Store as vec4 (column-major: col0.x, col0.y, col1.x, col1.y)
    covInvBuf[idx] = vec4(covI[0][0], covI[0][1], covI[1][0], covI[1][1]);

    // Spherical harmonics colour — SH coefficients are defined in world space,
    // so the view direction must be the world-space camera→Gaussian vector.
    vec3 cameraWorldPos = (inverse(ubo.model * ubo.view))[3].xyz;
    vec3 dir = normalize(p - cameraWorldPos);
    vec3 color = vec3(
        computeSH(ca.r, shRc, dir),
        computeSH(ca.g, shGc, dir),
        computeSH(ca.b, shBc, dir));
    colorAlpha2D[idx] = vec4(color, ca.a);
}
