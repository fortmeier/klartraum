#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 128) in;

// SoA projected Gaussian2D inputs
layout(scalar, set = 0, binding = 0) readonly buffer InPos2D      { vec2  inPos2D[];      };
layout(scalar, set = 0, binding = 1) readonly buffer InZ          { float inZ[];          };
layout(scalar, set = 0, binding = 2) readonly buffer InCovInv     { vec4  inCovInv[];     }; // (m00,m10,m01,m11)
layout(scalar, set = 0, binding = 3) readonly buffer InColorAlpha { vec4  inColorAlpha[]; }; // (r,g,b,alpha)

// Prefix sums from the histogram pass (reused AoS prefix sum shader)
layout(scalar, set = 0, binding = 4) readonly buffer PrefixSumBuf { uint prefixSums[]; };

// Total binned element count (accumulated by this shader)
layout(scalar, set = 0, binding = 5) buffer TotalCountBuf { uint totalCount; };

// SoA binned Gaussian2D outputs
layout(scalar, set = 0, binding = 6)  buffer OutPos2D      { vec2  outPos2D[];      };
layout(scalar, set = 0, binding = 7)  buffer OutZ          { float outZ[];          };
layout(scalar, set = 0, binding = 8)  buffer OutBinMask    { uint  outBinMask[];    };
layout(scalar, set = 0, binding = 9)  buffer OutCovInv     { vec4  outCovInv[];     };
layout(scalar, set = 0, binding = 10) buffer OutColorAlpha { vec4  outColorAlpha[]; };

layout(push_constant) uniform PC {
    uint  numElements;
    uint  gridSize;
    float screenWidth;
    float screenHeight;
    uint  maxOutput;
    float spreadMultiplier;   // tunable: Gaussian footprint radius multiplier (default 2.5)
} pc;

shared uint sharedScan[128];
shared uint sharedBinCounts[16];

// Compute per-thread overlap bitmask for ALL bins in one pass.
// Avoids calling inverse() 16× per thread — instead computes the spread once
// directly from covInv (ci stored column-major: m00=ci.x, m10=ci.y, m01=ci.z, m11=ci.w).
// For symmetric covInv:  det = m00*m11 - m01*m10
//   cov[0][0] = m11/det,  cov[1][1] = m00/det
uint computeOverlapMask(vec2 position, vec4 ci) {
    float det     = ci.x * ci.w - ci.y * ci.z;
    vec2  spread  = sqrt(vec2(ci.w, ci.x) / det) * pc.spreadMultiplier;
    vec2  gMin    = position - spread;
    vec2  gMax    = position + spread;

    float cellW = pc.screenWidth  / float(pc.gridSize);
    float cellH = pc.screenHeight / float(pc.gridSize);

    uint numBins = pc.gridSize * pc.gridSize;
    uint mask = 0u;
    for (uint b = 0u; b < numBins; b++) {
        uint gridX = b % pc.gridSize;
        uint gridY = b / pc.gridSize;
        vec2 binMin = vec2(float(gridX)      * cellW, float(gridY)      * cellH);
        vec2 binMax = vec2(float(gridX + 1u) * cellW, float(gridY + 1u) * cellH);
        if (!(gMax.x < binMin.x || gMin.x > binMax.x ||
              gMax.y < binMin.y || gMin.y > binMax.y)) {
            mask |= (1u << b);
        }
    }
    return mask;
}

void main() {
    uint lid    = gl_LocalInvocationIndex;
    uint idx    = gl_GlobalInvocationID.x;
    uint wgID   = gl_WorkGroupID.x;
    uint numWGs = gl_NumWorkGroups.x;
    uint numBins = pc.gridSize * pc.gridSize;

    bool inRange = (idx < pc.numElements);
    vec2  gPos;
    float gZ;
    vec4  gCovInv;
    vec4  gColorAlpha;
    bool validZ = false;

    if (inRange) {
        gZ          = inZ[idx];
        gPos        = inPos2D[idx];
        gCovInv     = inCovInv[idx];
        gColorAlpha = inColorAlpha[idx];
        validZ      = (gZ >= 0.0 && gZ <= 1.0);
    }

    // Compute overlap bitmask ONCE (replaces 16× overlapsWithBin calls each with inverse())
    uint overlapMask = (validZ) ? computeOverlapMask(gPos, gCovInv) : 0u;

    for (uint b = 0u; b < numBins; b++) {
        bool overlaps = (overlapMask >> b & 1u) != 0u;

        sharedScan[lid] = overlaps ? 1u : 0u;
        barrier();

        for (uint stride = 1u; stride < 128u; stride <<= 1u) {
            uint val = sharedScan[lid];
            if (lid >= stride) val += sharedScan[lid - stride];
            barrier();
            sharedScan[lid] = val;
            barrier();
        }

        uint inclusiveVal = sharedScan[lid];
        uint totalInWg    = sharedScan[127];
        if (lid == 0u) sharedBinCounts[b] = totalInWg;

        if (overlaps) {
            uint exclusiveRank = inclusiveVal - 1u;
            uint basePos       = prefixSums[numWGs * b + wgID];
            uint globalPos     = basePos + exclusiveRank;
            if (globalPos < pc.maxOutput) {
                outPos2D[globalPos]      = gPos;
                outZ[globalPos]          = gZ;
                outBinMask[globalPos]    = 1u << b;
                outCovInv[globalPos]     = gCovInv;
                outColorAlpha[globalPos] = gColorAlpha;
            }
        }
        barrier();
    }

    if (lid == 0u) {
        uint workgroupTotal = 0u;
        for (uint b = 0u; b < numBins; b++) {
            uint basePos   = prefixSums[numWGs * b + wgID];
            uint count     = sharedBinCounts[b];
            uint available = (basePos < pc.maxOutput) ? (pc.maxOutput - basePos) : 0u;
            workgroupTotal += min(count, available);
        }
        atomicAdd(totalCount, workgroupTotal);
    }
}
